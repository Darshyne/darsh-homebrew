{
  "id": "darsh-homebrew",
  "title": "DAS · Homebrew",
  "description": "Step-by-step creator of automated items for Darshyne's Automation Suite (DAS): spells, features, magic items and monster features, built from the dnd5e-combat engine's building blocks, without code.",
  "version": "0.2.2",
  "authors": [
    {
      "name": "Darshyne"
    }
  ],
  "url": "https://github.com/Darshyne/darsh-homebrew",
  "license": "https://github.com/Darshyne/darsh-homebrew/blob/main/LICENSE",
  "manifest": "https://github.com/Darshyne/darsh-homebrew/releases/latest/download/module.json",
  "download": "https://github.com/Darshyne/darsh-homebrew/releases/latest/download/module.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.369"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "dnd5e-combat",
        "type": "module",
        "compatibility": {
          "minimum": "0.201.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/darsh-homebrew.mjs"
  ],
  "styles": [
    "styles/darsh-homebrew.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ]
}
