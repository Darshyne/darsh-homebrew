{
  "id": "darsh-homebrew",
  "title": "DAS · Homebrew",
  "description": "Créateur d'objets automatisés pour la suite DAS : sorts, aptitudes, objets magiques et capacités de monstres, composés pas à pas à partir des briques du moteur, sans code.",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Darshyne"
    }
  ],
  "url": "https://github.com/Darshyne/darsh-homebrew",
  "license": "https://github.com/Darshyne/darsh-homebrew/blob/main/LICENSE",
  "manifest": "https://github.com/Darshyne/darsh-homebrew/releases/latest/download/module.json",
  "download": "https://github.com/Darshyne/darsh-homebrew/releases/latest/download/module.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.367"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "dnd5e-combat",
        "type": "module",
        "compatibility": {
          "minimum": "0.200.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/darsh-homebrew.mjs"
  ],
  "styles": [
    "styles/darsh-homebrew.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ]
}
